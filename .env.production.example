# Copy to .env next to docker-compose.prod.yml and fill in every value.
# Never commit the filled-in file.

# Domain pointing at this server (A/AAAA record), without https://
DOMAIN=example.com
# Email for Let's Encrypt certificate notices
ACME_EMAIL=you@example.com

# Database (use a long random value: openssl rand -hex 24)
POSTGRES_USER=mierag
POSTGRES_PASSWORD=
POSTGRES_DB=mierag

# API secrets (JWT_SECRET: openssl rand -hex 32)
JWT_SECRET=
# Admin account created by the seed. Re-running the seed resets this password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Where new application and message emails are sent
ADMIN_NOTIFICATION_EMAIL=

# Outgoing email (optional; leave empty to disable email notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
